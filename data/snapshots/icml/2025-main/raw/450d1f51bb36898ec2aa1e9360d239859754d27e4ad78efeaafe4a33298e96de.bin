<div class="virtual-card">
    <a class="small-title text-underline-hover" href="/virtual/2025/oral/47269">The Value of Prediction in Identifying the Worst-Off</a>
</div>
<div class="type_display_name_virtual_card">Oral</div>
<div class="author-str">Unai Fischer Abaigar &middot; Christoph Kern &middot; Juan Perdomo</div>
<div class="author-str higher"></div>
<div class="text-muted touchup-date-div" id="touchup-date-event-47269"></div>


