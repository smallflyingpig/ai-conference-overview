---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DataStatus from "../../../components/DataStatus.astro";
import TopicShareChart from "../../../components/TopicShareChart";
import { awardFilterHref } from "../../../lib/award-filter";
import { loadPublishedOverviews } from "../../../lib/data";
import { auditStatusLabel, buildConferenceView, conferenceRoutes, type ConferenceView } from "../../../lib/views";

export async function getStaticPaths() {
  const releases = await loadPublishedOverviews();
  return conferenceRoutes(releases).map((route, index) => ({
    ...route,
    props: { view: buildConferenceView(releases[index]) },
  }));
}

interface Props { view: ConferenceView }
const { view } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`${view.venue} ${view.year} 论文 — AI Conference Overview`}
  description={`${view.scopeLabel} 的论文清单${view.mode === "distribution" ? "和主题分布" : ""}。`}
  conferenceAvailable={true}
>
  <div class="conference-shell">
    <aside class="conference-axis">
      <p class="eyebrow">会议信息</p>
      <p class="conference-monogram" aria-hidden="true">{view.venue}</p>
      <h1>{view.pageHeading}</h1>
      <dl class="identity-index">
        <div><dt>内容</dt><dd>{view.mode === "papers-only" ? "论文清单" : "主题分布"}</dd></div>
        <div><dt>时间</dt><dd>{view.periodLabel}</dd></div>
        <div><dt>范围</dt><dd>{view.scopeLabel}</dd></div>
      </dl>
      <DataStatus
        included={view.includedCount}
        excluded={view.excludedCount}
        discovered={view.discoveredCount}
        abstractCoverage={view.abstractCoverageLabel}
        retrievedAt={view.retrievedAt}
        sourceName={view.sourceName}
        sourceUrl={view.sourceUrl}
        sourceHash={view.sourceHash}
      />
    </aside>

    {view.mode === "papers-only" ? (
      <article class="distribution-plane preliminary-conference">
        <header class="distribution-header">
          <p class="eyebrow">{view.publicationStatus === "final" ? "正式论文集" : "预发布论文清单"}</p>
          <h2>主会论文已经可以浏览。</h2>
          <p class="preliminary-notice">{view.publicationNotice}</p>
        </header>
        <section class="preliminary-scope" aria-labelledby="included-scope">
          <div><h3 id="included-scope">本次收录</h3><p>{view.venue} {view.year} Main Conference 官方论文记录，以及官方来源提供的英文摘要和论文信息。</p></div>
          <div><h3>本轮暂不提供</h3><p>Workshops 等其他 track，以及主题分布、趋势、Advances 和获奖论文分析。</p></div>
        </section>
        <p><a class="primary-link" href="/ai-conference-overview/papers/">浏览 {view.venue} {view.year} 论文</a></p>
        <footer class="artifact-trace"><span>{view.publicationStatus === "final" ? "数据来自正式论文集" : "等待正式论文集发布后再次对照"}</span><code>{view.generation}</code></footer>
      </article>
    ) : (
    <article class="distribution-plane">
      <header class="distribution-header">
        <p class="eyebrow">主题分布</p>
        <h2>{view.auditPassedThemeCount > 0 ? "经过 AI 辅助复核的主题分布。" : "初步主题分布。"}</h2>
        <p>
          每篇论文只归入一个主要主题（primary topic），各主题占比按<strong>{view.denominatorLabel}</strong>计算。
          当前只有一年的数据，因此不展示同比变化，也不判断长期趋势。
        </p>
        {view.venue === "ICML" && view.year === 2025 && (
          <p class="single-year-note">当前只有 ICML 2025 单年数据，可以查看主题分布与研究热点，暂不能判断时间趋势。</p>
        )}
      </header>

      <p class="conference-paper-entry">
        <a class="primary-link" href="/ai-conference-overview/papers/">浏览 {view.venue} {view.year} 论文</a>
      </p>

      <section aria-labelledby="topic-title">
        <div class="section-line">
          <h3 id="topic-title">主要主题占比</h3>
          <span>
            {view.auditPassedThemeCount} 个主题通过 AI 辅助复核 · {view.experimentalThemeCount} 个主题仅展示初步结果
            {view.withheldThemeCount > 0 ? ` · ${view.withheldThemeCount} 个暂不纳入主要分析` : ""}
          </span>
        </div>
        {view.auditPassedThemeCount === 0 && (
          <p>
            所有主题分类仍未完成 AI 辅助复核，目前只展示初步分布。
          </p>
        )}
        <TopicShareChart rows={view.topics} denominator={view.includedCount} />
      </section>

      {view.hotspots.length > 0 && (
        <section class="conference-hotspots" aria-labelledby="hotspot-title">
          <div class="section-line">
            <h3 id="hotspot-title">研究热点</h3>
            <span>基于本届论文的单年归纳</span>
          </div>
          <ol>
            {view.hotspots.map((hotspot) => (
              <li>
                <span class="data-label">{hotspot.label}</span>
                <h4>{hotspot.question}</h4>
                <p>{hotspot.summary}</p>
                <ul>{hotspot.papers.map((paper) => <li><a href={paper.url}>{paper.title}</a></li>)}</ul>
              </li>
            ))}
          </ol>
        </section>
      )}

      {view.awardCount > 0 && (
        <section class="conference-award-entry" aria-labelledby="conference-award-title">
          <div>
            <p class="eyebrow">获奖论文解读</p>
            <h3 id="conference-award-title">本届共有 {view.awardCount} 篇获奖论文解读。</h3>
            <p>每篇解读按研究问题、核心方法、主要发现和适用范围组织，并附论文官方页面。</p>
          </div>
          <a href={awardFilterHref(base, view.venue, view.year)}>查看本届 {view.awardCount} 篇获奖论文解读</a>
        </section>
      )}

      <section class="representative-index" aria-labelledby="representative-title">
        <div class="section-line">
          <h3 id="representative-title">示例论文</h3>
          <span>各主题中分类置信度最高的一篇论文</span>
        </div>
        <ol>
          {view.topics.map((row) => (
            <li>
              <span>{row.topicLabel}</span>
              <a href={row.preliminaryExample.url}>{row.preliminaryExample.title}</a>
              {row.auditStatus !== "audit-passed" && <small>{auditStatusLabel(row.auditStatus)}</small>}
            </li>
          ))}
        </ol>
      </section>

      <footer class="artifact-trace">
        <span>主题分类版本 {view.taxonomyVersion}</span>
        <code>{view.generation}</code>
      </footer>
    </article>
    )}
  </div>
</BaseLayout>
