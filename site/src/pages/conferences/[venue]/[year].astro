---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DataStatus from "../../../components/DataStatus.astro";
import TopicShareChart from "../../../components/TopicShareChart";
import { loadPublishedOverviews } from "../../../lib/data";
import { auditStatusLabel, buildConferenceView, conferenceRoutes, type ConferenceView } from "../../../lib/views";

export async function getStaticPaths() {
  const releases = await loadPublishedOverviews();
  return conferenceRoutes(releases).map((route, index) => ({
    ...route,
    props: { view: buildConferenceView(releases[index]) },
  }));
}

interface Props { view: ConferenceView }
const { view } = Astro.props;
---

<BaseLayout
  title={`${view.venue} ${view.year} 论文分布 — AI Conference Overview`}
  description={`${view.scopeLabel} 的论文清单和经过人工抽查的主题分布。`}
  conferenceAvailable={true}
>
  <div class="conference-shell">
    <aside class="conference-axis">
      <p class="eyebrow">会议信息</p>
      <p class="conference-monogram" aria-hidden="true">{view.venue}</p>
      <h1>{view.pageHeading}</h1>
      <dl class="identity-index">
        <div><dt>视图</dt><dd>分布</dd></div>
        <div><dt>时间</dt><dd>{view.periodLabel}</dd></div>
        <div><dt>范围</dt><dd>{view.scopeLabel}</dd></div>
      </dl>
      <DataStatus
        included={view.includedCount}
        excluded={view.excludedCount}
        discovered={view.discoveredCount}
        abstractCoverage={view.abstractCoverageLabel}
        retrievedAt={view.retrievedAt}
        sourceName={view.sourceName}
        sourceUrl={view.sourceUrl}
        sourceHash={view.sourceHash}
      />
    </aside>

    {view.mode === "papers-only" ? (
      <article class="distribution-plane preliminary-conference">
        <header class="distribution-header">
          <p class="eyebrow">预发布论文清单</p>
          <h2>主会论文已经可以浏览。</h2>
          <p class="preliminary-notice">{view.publicationNotice}</p>
        </header>
        <section class="preliminary-scope" aria-labelledby="included-scope">
          <div><h3 id="included-scope">本次收录</h3><p>ICML 2026 Main Conference 官方论文记录，以及官网提供的英文摘要和展示信息。</p></div>
          <div><h3>暂不包含</h3><p>Position Papers、Journal-to-Conference、workshops、主题分布、趋势、Advances 和获奖论文分析。</p></div>
        </section>
        <p><a class="primary-link" href="/ai-conference-overview/papers/">浏览 ICML 2026 论文</a></p>
        <footer class="artifact-trace"><span>等待 PMLR Volume 306 最终对照</span><code>{view.generation}</code></footer>
      </article>
    ) : (
    <article class="distribution-plane">
      <header class="distribution-header">
        <p class="eyebrow">主题分布</p>
        <h2>{view.auditPassedThemeCount > 0 ? "经过人工抽查的主题分布。" : "初步主题分布。"}</h2>
        <p>
          每篇论文只归入一个主要主题（primary topic），各主题占比按<strong>{view.denominatorLabel}</strong>计算。
          当前只有一年的数据，因此不展示同比变化，也不判断长期趋势。
        </p>
      </header>

      <section aria-labelledby="topic-title">
        <div class="section-line">
          <h3 id="topic-title">主要主题占比</h3>
          <span>
            {view.auditPassedThemeCount} 个主题通过人工抽查 · {view.experimentalThemeCount} 个主题仅展示初步结果
            {view.withheldThemeCount > 0 ? ` · ${view.withheldThemeCount} 个暂不纳入主要分析` : ""}
          </span>
        </div>
        {view.auditPassedThemeCount === 0 && (
          <p>
            所有主题分类仍在等待独立人工抽查，目前只展示初步分布。
          </p>
        )}
        <TopicShareChart rows={view.topics} denominator={view.includedCount} />
      </section>

      <section class="representative-index" aria-labelledby="representative-title">
        <div class="section-line">
          <h3 id="representative-title">示例论文</h3>
          <span>各主题中分类置信度最高的一篇论文</span>
        </div>
        <ol>
          {view.topics.map((row) => (
            <li>
              <span>{row.topicLabel}</span>
              <a href={row.preliminaryExample.url}>{row.preliminaryExample.title}</a>
              {row.auditStatus !== "audit-passed" && <small>{auditStatusLabel(row.auditStatus)}</small>}
            </li>
          ))}
        </ol>
      </section>

      <footer class="artifact-trace">
        <span>主题分类版本 {view.taxonomyVersion}</span>
        <code>{view.generation}</code>
      </footer>
    </article>
    )}
  </div>
</BaseLayout>
