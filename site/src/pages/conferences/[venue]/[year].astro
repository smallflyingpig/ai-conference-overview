---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DataStatus from "../../../components/DataStatus.astro";
import TopicShareChart from "../../../components/TopicShareChart";
import { loadOverview } from "../../../lib/data";
import { buildConferenceView, conferenceRoutes, type ConferenceView } from "../../../lib/views";

export async function getStaticPaths() {
  const release = await loadOverview("ACL", 2026);
  const releases = release == null ? [] : [release];
  return conferenceRoutes(releases).map((route, index) => ({
    ...route,
    props: { view: buildConferenceView(releases[index]) },
  }));
}

interface Props { view: ConferenceView }
const { view } = Astro.props;
---

<BaseLayout
  title={`${view.venue} ${view.year} ${view.analysisLabel} — AI Conference Overview`}
  description={`Validated ${view.scopeLabel} corpus with an audit-labeled topic distribution.`}
  conferenceAvailable={true}
>
  <div class="conference-shell">
    <aside class="conference-axis">
      <p class="eyebrow">Conference identity</p>
      <p class="conference-monogram" aria-hidden="true">{view.venue}</p>
      <h1>{view.pageHeading}</h1>
      <dl class="identity-index">
        <div><dt>View</dt><dd>{view.analysisLabel}</dd></div>
        <div><dt>Period</dt><dd>{view.periodLabel}</dd></div>
        <div><dt>Scope</dt><dd>{view.scopeLabel}</dd></div>
      </dl>
      <DataStatus
        included={view.includedCount}
        excluded={view.excludedCount}
        discovered={view.discoveredCount}
        abstractCoverage={view.abstractCoverageLabel}
        retrievedAt={view.retrievedAt}
        sourceName={view.sourceName}
        sourceUrl={view.sourceUrl}
        sourceHash={view.sourceHash}
      />
    </aside>

    <article class="distribution-plane">
      <header class="distribution-header">
        <p class="eyebrow">Distribution evidence</p>
        <h2>{view.auditPassedThemeCount === view.topics.length ? "Where accepted work concentrates." : "Preliminary assisted distribution."}</h2>
        <p>
          Primary-topic shares use <strong>{view.denominatorLabel}</strong> as the denominator.
          This is a one-year snapshot, so no year-over-year or trend claim is shown.
        </p>
      </header>

      <section aria-labelledby="topic-title">
        <div class="section-line">
          <h3 id="topic-title">Primary topic shares</h3>
          <span>
            {view.auditPassedThemeCount} audit-passed · {view.experimentalThemeCount} experimental
            {view.withheldThemeCount > 0 ? ` · ${view.withheldThemeCount} withheld` : ""}
          </span>
        </div>
        {view.auditPassedThemeCount === 0 && (
          <p>
            All topic labels are assisted-classification outputs pending semantic audit.
            Treat this distribution as preliminary, not publication-safe evidence.
          </p>
        )}
        <TopicShareChart rows={view.topics} denominator={view.includedCount} />
      </section>

      <section class="representative-index" aria-labelledby="representative-title">
        <div class="section-line">
          <h3 id="representative-title">Representative papers</h3>
          <span>Highest-confidence assignment per theme</span>
        </div>
        <ol>
          {view.topics.map((row) => (
            <li>
              <span>{row.topic}</span>
              <a href={row.representativePaper.url}>{row.representativePaper.title}</a>
              {row.auditStatus !== "audit-passed" && <small>{row.auditStatus}</small>}
            </li>
          ))}
        </ol>
      </section>

      <footer class="artifact-trace">
        <span>Taxonomy {view.taxonomyVersion}</span>
        <code>{view.generation}</code>
      </footer>
    </article>
  </div>
</BaseLayout>
