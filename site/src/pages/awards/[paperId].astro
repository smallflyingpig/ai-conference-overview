---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AwardMethodDiagram from "../../components/AwardMethodDiagram";
import AwardResultClaim from "../../components/AwardResultClaim";
import AwardEvidenceSections from "../../components/AwardEvidenceSections";
import AwardChineseReading from "../../components/AwardChineseReading.astro";
import { loadAuthoredAwardContent } from "../../lib/authored-award-content";
import { loadChineseContent } from "../../lib/content-data";
import { loadOverview } from "../../lib/data";
import { awardChineseInsight, awardDetailRoutes, awardTypeLabel, type AwardDetailView } from "../../lib/evidence";
import { buildAwardChineseReading, type AwardChineseReading as AwardChineseReadingView } from "../../lib/paper-reading";

export async function getStaticPaths() {
  const release = await loadOverview("ACL", 2026);
  if (release == null) return [];
  const content = await loadChineseContent(release);
  const awardContent = content ?? await loadAuthoredAwardContent(release);
  return awardDetailRoutes(release).map((route) => ({
    ...route,
    props: {
      ...route.props,
      reading: buildAwardChineseReading(release, awardContent, route.props.detail.paper.paper_id),
    },
  }));
}

interface Props { detail: AwardDetailView; reading: AwardChineseReadingView | null }
const { detail, reading } = Astro.props;
---

<BaseLayout title={`${detail.paper.title} — 获奖论文解读`} description={`${detail.paper.title} 的中文解读。`} conferenceAvailable={true}>
  <article class="evidence-shell award-reading">
    <header class="page-thesis award-thesis">
      <p class="eyebrow">{awardTypeLabel(detail.award.award_type)} · 官方信息已确认</p>
      <h1>{detail.paper.title}</h1>
      <p>{detail.paper.authors.join(", ")}</p>
      <div class="plate-links"><a href={detail.award.evidence_url!}>官方获奖页面</a><a href={detail.paper.landing_url}>论文官方页面</a>{detail.paper.pdf_url && <a href={detail.paper.pdf_url}>PDF</a>}</div>
    </header>

    {reading
      ? <AwardChineseReading reading={reading} />
      : <section class="why-ledger" aria-labelledby="chinese-reading-title">
          <h2 id="chinese-reading-title">核心解读</h2>
          <article>
            <span class="evidence-badge evidence-badge--synthesis">中文解读</span>
            <p>{awardChineseInsight(detail.paper.paper_id)}</p>
          </article>
        </section>}

    <details class="original-deep-read">
      <summary>英文原文参考</summary>
      <p>这里保留论文中的英文表述、实验指标和原文位置，方便进一步查阅。</p>
      {detail.deepRead.method_diagram && <AwardMethodDiagram diagram={detail.deepRead.method_diagram} />}
      <AwardEvidenceSections deepRead={detail.deepRead} />
      <section class="result-ledger" aria-labelledby="results-title">
        <h2 id="results-title">论文原文中的结果</h2>
        {detail.deepRead.result_claims.map((claim) => <AwardResultClaim claim={claim} />)}
      </section>
    </details>
  </article>
</BaseLayout>
