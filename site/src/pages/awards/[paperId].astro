---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AwardMethodDiagram from "../../components/AwardMethodDiagram";
import AwardResultClaim from "../../components/AwardResultClaim";
import AwardEvidenceSections from "../../components/AwardEvidenceSections";
import { loadOverview } from "../../lib/data";
import { awardDetailRoutes, type AwardDetailView } from "../../lib/evidence";

export async function getStaticPaths() {
  const release = await loadOverview("ACL", 2026);
  return awardDetailRoutes(release);
}

interface Props { detail: AwardDetailView }
const { detail } = Astro.props;
---

<BaseLayout title={`${detail.paper.title} — Award reading`} description={`Evidence-grounded reading of ${detail.paper.title}.`} conferenceAvailable={true}>
  <article class="evidence-shell award-reading">
    <header class="page-thesis award-thesis">
      <p class="eyebrow">{detail.award.award_type} · officially verified</p>
      <h1>{detail.paper.title}</h1>
      <p>{detail.paper.authors.join(", ")}</p>
      <div class="plate-links"><a href={detail.award.evidence_url!}>Official award evidence</a><a href={detail.paper.landing_url}>Paper landing page</a>{detail.paper.pdf_url && <a href={detail.paper.pdf_url}>PDF</a>}</div>
    </header>

    {detail.deepRead.method_diagram && <AwardMethodDiagram diagram={detail.deepRead.method_diagram} />}

    <AwardEvidenceSections deepRead={detail.deepRead} />

    <section class="result-ledger" aria-labelledby="results-title">
      <h2 id="results-title">Paper-reported results</h2>
      {detail.deepRead.result_claims.map((claim) => <AwardResultClaim claim={claim} />)}
    </section>

  </article>
</BaseLayout>
