---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadOverview } from "../../lib/data";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import { advanceCategories, buildAdvances } from "../../lib/evidence";

const release = await loadOverview("ACL", 2026);
const lanes = release == null ? advanceCategories.map((category) => ({ ...category, advances: [] })) : buildAdvances(release);
---

<BaseLayout title="Advances — AI Conference Overview" description="Evidence-labeled advances across major AI research lanes." conferenceAvailable={release != null}>
  <div class="evidence-shell advances-shell">
    <header class="page-thesis">
      <p class="eyebrow">Synthesis lanes</p>
      <h1>Advance only<br />what evidence carries.</h1>
      <p>Each lane links named official papers and separates paper-reported claims, cross-paper synthesis, and inference. Audit-passed lanes are published as bounded synthesis; withheld themes remain experimental.</p>
    </header>
    <div class="advance-ledger" aria-label="Advance categories">
      {lanes.map((category) => (
        <section id={category.id} class="advance-lane">
          <p class="data-label">{category.advances.length === 0 ? "Evidence-limited" : category.advances.some((advance) => advance.title.startsWith("Audited ")) ? "Audited synthesis" : "Experimental observation"}</p>
          <h2>{category.label}</h2>
          {category.advances.length === 0 ? <p>{release == null ? "No validated release is available." : "No categorized paper-level synthesis is published for this lane."}</p> : <div class="advance-entries">{category.advances.map((advance) => <article><h3>{advance.title}</h3><p class="data-label">Supporting papers</p><ul>{advance.supportingPapers.map((paper) => <li><a href={paper.officialUrl}>{paper.title}</a></li>)}</ul>{advance.claims.map((claim) => <div><EvidenceBadge type={claim.evidence_type} /><p>{claim.claim}</p><small>{claim.locator}</small><span class="claim-sources">{claim.source_urls.map((url, index) => <a href={url}>Claim source {index + 1}</a>)}</span></div>)}</article>)}</div>}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
