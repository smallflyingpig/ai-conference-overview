---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrendExplorer from "../../components/TrendExplorer";
import { loadOverview } from "../../lib/data";
import { projectPath } from "../../lib/paths";
import { buildTrendView } from "../../lib/views";

const aclRelease = await loadOverview("ACL", 2026, undefined, "long");
const view = buildTrendView(aclRelease == null ? [] : [aclRelease]);
const action = projectPath(import.meta.env.BASE_URL, "trends");
---

<BaseLayout
  title="Distributions and trends — AI Conference Overview"
  description="Validated conference distributions, with trend claims gated on comparable multi-year evidence."
  conferenceAvailable={aclRelease != null}
>
  <TrendExplorer view={view} action={action} client:load />
</BaseLayout>
