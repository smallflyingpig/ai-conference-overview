---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadOverview } from "../../lib/data";
import { filterPapers } from "../../lib/evidence";

const release = await loadOverview("ACL", 2026);
const papers = release == null ? [] : filterPapers(release, { query: "", theme: null });
const themes = [...new Set(papers.map((paper) => paper.theme))].sort();
---

<BaseLayout title="Papers — AI Conference Overview" description="Searchable, filterable index of validated conference papers." conferenceAvailable={release != null}>
  <div class="evidence-shell papers-shell">
    <header class="page-thesis paper-thesis">
      <p class="eyebrow">Compact research index</p>
      <h1>Find the paper.<br />Keep the source.</h1>
      <p>Search title, author, or stable paper ID; filter by audited primary theme. Missing optional links are left blank rather than interpreted.</p>
    </header>
    <section class="paper-index" aria-labelledby="paper-index-title">
      <h2 id="paper-index-title">Validated papers</h2>
      {release == null ? (
        <div class="empty-atlas" role="status"><span class="status-mark" aria-hidden="true"></span><div><h3>No paper index published</h3><p>A validated current release is required.</p></div></div>
      ) : (
        <>
          <form class="paper-controls" role="search">
            <label for="paper-query">Search papers</label>
            <input class="research-filter" id="paper-query" type="search" placeholder="Title, author, or paper ID" />
            <label for="paper-theme">Primary theme</label>
            <select class="research-filter" id="paper-theme"><option value="">All audited themes</option>{themes.map((theme) => <option value={theme}>{theme}</option>)}</select>
          </form>
          <p class="data-label" id="paper-count" aria-live="polite">{papers.length} PAPERS</p>
          <ol class="paper-rows" id="paper-rows">
            {papers.map((paper) => (
              <li data-paper-row data-search={[paper.paperId, paper.title, ...paper.authors].join(" ").toLocaleLowerCase()} data-theme={paper.theme}>
                <span class="data-label">{paper.theme}</span>
                <h3><a href={paper.officialUrl}>{paper.title}</a></h3>
                <p>{paper.authors.join(", ")}</p>
                <div class="plate-links"><a href={paper.officialUrl}>Official page</a>{paper.pdfUrl && <a href={paper.pdfUrl}>PDF</a>}{paper.codeUrl && <a href={paper.codeUrl}>Code</a>}</div>
              </li>
            ))}
          </ol>
        </>
      )}
    </section>
  </div>
</BaseLayout>

<script>
  const query = document.querySelector<HTMLInputElement>("#paper-query");
  const theme = document.querySelector<HTMLSelectElement>("#paper-theme");
  const rows = [...document.querySelectorAll<HTMLElement>("[data-paper-row]")];
  const count = document.querySelector<HTMLElement>("#paper-count");
  function applyFilters() {
    const needle = query?.value.trim().toLocaleLowerCase() ?? "";
    const selectedTheme = theme?.value ?? "";
    let visible = 0;
    rows.forEach((row) => {
      const matches = (row.dataset.search?.includes(needle) ?? false) && (!selectedTheme || row.dataset.theme === selectedTheme);
      row.hidden = !matches;
      if (matches) visible += 1;
    });
    if (count) count.textContent = `${visible} PAPERS`;
  }
  query?.addEventListener("input", applyFilters);
  theme?.addEventListener("change", applyFilters);
</script>
