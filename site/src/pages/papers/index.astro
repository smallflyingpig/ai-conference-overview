---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublishedOverviews } from "../../lib/data";
import { filterPapers } from "../../lib/evidence";
import { displayTopicLabel } from "../../lib/views";

const releases = await loadPublishedOverviews();
const papers = filterPapers(releases, { query: "", theme: null, venue: null });
const themes = [...new Set(papers.flatMap((paper) => paper.theme == null ? [] : [paper.theme]))].sort();
const venues = [...new Set(papers.map((paper) => paper.venue))].sort();
---

<BaseLayout title="论文索引 — AI Conference Overview" description="可搜索、可筛选的会议论文索引。" conferenceAvailable={releases.length > 0}>
  <div class="evidence-shell papers-shell">
    <header class="page-thesis paper-thesis">
      <p class="eyebrow">论文索引</p>
      <h1>快速找到论文，<br />直接回到官方来源。</h1>
      <p>可以按标题、作者或 paper ID 搜索，也可以按主要主题（primary topic）筛选。主题分类的 AI 辅助复核结果可在“方法说明”页面查看。</p>
    </header>
    <section class="paper-index" aria-labelledby="paper-index-title">
      <h2 id="paper-index-title">已收录论文</h2>
      {releases.length === 0 ? (
        <div class="empty-atlas" role="status"><span class="status-mark" aria-hidden="true"></span><div><h3>尚未发布论文索引</h3><p>论文清单完成检查并正式发布后，这里会提供搜索和筛选。</p></div></div>
      ) : (
        <>
          <form class="paper-controls" role="search">
            <label for="paper-query">搜索论文</label>
            <input class="research-filter" id="paper-query" type="search" placeholder="标题、作者或 paper ID" />
            <label for="paper-venue">会议</label>
            <select class="research-filter" id="paper-venue"><option value="">全部会议</option>{venues.map((venue) => <option value={venue}>{venue}</option>)}</select>
            <label for="paper-theme">主要主题</label>
            <select class="research-filter" id="paper-theme"><option value="">全部已分类主题</option>{themes.map((theme) => <option value={theme}>{displayTopicLabel(theme)}</option>)}</select>
          </form>
          <p class="data-label" id="paper-count" aria-live="polite">{papers.length} 篇论文</p>
          <ol class="paper-rows" id="paper-rows">
            {papers.map((paper) => (
              <li data-paper-row data-search={[paper.paperId, paper.title, ...paper.authors].join(" ").toLocaleLowerCase()} data-theme={paper.theme ?? ""} data-venue={paper.venue}>
                <span class="data-label">{paper.venue} {paper.year} · {paper.theme == null ? "暂未分类" : displayTopicLabel(paper.theme)}</span>
                <h3><a data-paper-detail={paper.detailUrl != null} href={paper.detailUrl ?? paper.officialUrl}>{paper.title}</a></h3>
                <p>{paper.authors.join(", ")}</p>
                <div class="plate-links"><a href={paper.officialUrl}>官方页面</a>{paper.pdfUrl && <a href={paper.pdfUrl}>PDF</a>}{paper.codeUrl && <a href={paper.codeUrl}>Code</a>}</div>
              </li>
            ))}
          </ol>
        </>
      )}
    </section>
  </div>
</BaseLayout>

<script>
  const query = document.querySelector<HTMLInputElement>("#paper-query");
  const theme = document.querySelector<HTMLSelectElement>("#paper-theme");
  const venue = document.querySelector<HTMLSelectElement>("#paper-venue");
  const rows = [...document.querySelectorAll<HTMLElement>("[data-paper-row]")];
  const count = document.querySelector<HTMLElement>("#paper-count");
  function applyFilters() {
    const needle = query?.value.trim().toLocaleLowerCase() ?? "";
    const selectedTheme = theme?.value ?? "";
    const selectedVenue = venue?.value ?? "";
    let visible = 0;
    rows.forEach((row) => {
      const matches = (row.dataset.search?.includes(needle) ?? false) && (!selectedTheme || row.dataset.theme === selectedTheme) && (!selectedVenue || row.dataset.venue === selectedVenue);
      row.hidden = !matches;
      if (matches) visible += 1;
    });
    if (count) count.textContent = `${visible} 篇论文`;
  }
  query?.addEventListener("input", applyFilters);
  theme?.addEventListener("change", applyFilters);
  venue?.addEventListener("change", applyFilters);
</script>
