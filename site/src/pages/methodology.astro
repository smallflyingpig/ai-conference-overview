---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceBadge from "../components/EvidenceBadge.astro";
import { loadPublishedOverviews } from "../lib/data";
import { buildMethodologyView } from "../lib/evidence";
import { auditStatusLabel, displayTopicLabel } from "../lib/views";

const entries = (await loadPublishedOverviews())
  .filter((release) => release.overview.publication_context?.analysis_availability.distribution ?? true)
  .map((release) => ({
    key: `${release.scope.venue}-${release.scope.year}-${release.scope.track}`,
    label: `${release.scope.venue} ${release.scope.year} ${release.scope.track === "findings" ? "Findings" : release.scope.track === "long" ? "长论文" : "主会论文"}`,
    view: buildMethodologyView(release),
  }));
---

<BaseLayout title="方法说明 — AI Conference Overview" description="数据来源、统计范围、计算公式、AI 辅助复核结果与已知局限。" conferenceAvailable={entries.length > 0}>
  <div class="evidence-shell methodology-shell">
    <header class="page-thesis methodology-thesis">
      <p class="eyebrow">分析方法</p>
      <h1>每个数字，<br />都能找到来源和计算方法。</h1>
      <p>这里公开记录原始来源、抓取时间、统计范围、分母、计算公式、AI 辅助复核结果和已知局限。</p>
    </header>
    {entries.length === 0 ? (
      <div class="empty-atlas" role="status"><span class="status-mark" aria-hidden="true"></span><div><h3>尚未发布方法说明</h3><p>正式数据版本发布后，这里会同步展示完整方法。</p></div></div>
    ) : (
      <div class="methodology-content">
      <nav class="advance-filter" aria-label="选择会议的方法说明">
        {entries.map((entry) => <a href={`#methodology-${entry.key}`}>{entry.label}</a>)}
      </nav>
      <div class="methodology-release-list">
      {entries.map(({ key, label, view }) => (
      <section id={`methodology-${key}`} class="methodology-release">
        <header class="advance-conference-heading"><p class="eyebrow">统计与复核方法</p><h2>{label}</h2><p>以下内容只对应这一论文集，不与其他 Track 混用。</p></header>
      <div class="audit-ledger">
        <section><h2>数据版本</h2><dl class="audit-grid"><div><dt>生成时间</dt><dd><time datetime={view.build.generatedAt}>{view.build.generatedAt}</time></dd></div><div><dt>生成程序</dt><dd><code>{view.build.producer}</code></dd></div><div><dt>格式版本</dt><dd>{view.build.schemaVersion}</dd></div></dl></section>
        <section><h2>数据来源</h2>{view.sources.map((source) => <dl class="audit-grid"><div><dt>来源</dt><dd><a href={source.url}>{source.name}</a></dd></div><div><dt>SHA-256</dt><dd><code>{source.sha256}</code></dd></div><div><dt>抓取时间</dt><dd><time datetime={source.retrievedAt}>{source.retrievedAt}</time></dd></div></dl>)}</section>
        <section><h2>统计范围</h2><dl class="audit-grid"><div><dt>会议 / 年份 / 论文类型</dt><dd>{view.scope.venue} / {view.scope.year} / {view.scope.track}</dd></div><div><dt>论文信息状态</dt><dd>{view.scope.inclusionStatuses.join(", ")}</dd></div><div><dt>统计口径</dt><dd>{view.scope.denominator}</dd></div><div><dt>对应数据字段</dt><dd><code>{view.scope.denominatorField}</code></dd></div><div><dt>论文数</dt><dd>{view.scope.denominatorValue} {view.scope.denominatorUnit}</dd></div><div><dt>排除的记录</dt><dd>{view.scope.exclusions}</dd></div><div><dt>主题分类版本</dt><dd>{view.taxonomyVersion}</dd></div><div><dt>比较方法编号</dt><dd><code>{view.contractIds.comparison}</code></dd></div><div><dt>公式版本</dt><dd>{view.contractIds.formula}</dd></div></dl></section>
        <section><h2>指标公式</h2>{view.formulas.map((formula) => <article class="formula-entry"><strong>{formula.name}</strong><code>{formula.formula}</code><small>{formula.version} · 分子：{formula.numerator}{formula.denominator ? ` · 分母：${formula.denominator}` : ""}</small></article>)}<dl class="audit-grid"><div><dt>参与比较的会议</dt><dd>{view.configuredVenues.length > 0 ? view.configuredVenues.join(", ") : "当前只有一个会议，暂不进行跨会议比较"}</dd></div><div><dt>会议集合编号</dt><dd><code>{view.contractIds.configuredVenuePopulation}</code></dd></div><div><dt>新兴主题得分权重</dt><dd>占比变化（share）{view.emergingScoreWeights.share_growth}；会议覆盖变化（spread）{view.emergingScoreWeights.spread_growth}；新颖度（novelty）{view.emergingScoreWeights.novelty}</dd></div></dl></section>
        <section><h2>缺失情况</h2><dl class="audit-grid"><div><dt>Abstract</dt><dd>{view.missingness.abstracts}</dd></div><div><dt>PDF</dt><dd>{view.missingness.pdfs}</dd></div><div><dt>DOI</dt><dd>{view.missingness.dois}</dd></div></dl></section>
        <section><h2>低置信度分类复查</h2><dl class="audit-grid"><div><dt>需要复查</dt><dd>{view.classificationReview.lowConfidenceCount} 篇</dd></div><div><dt>已经复查</dt><dd>{view.classificationReview.reviewedCount} 篇</dd></div><div><dt>尚待复查</dt><dd>{view.classificationReview.pendingCount} 篇</dd></div><div><dt>分类未通过</dt><dd>{view.classificationReview.rejectedCount} 篇</dd></div><div><dt>复查进度</dt><dd>{view.classificationReview.complete ? "已全部完成" : "尚未完成，暂不用于最终发布"}</dd></div></dl></section>
        {view.classificationLineage != null && <section><h2>分类处理记录</h2><dl class="audit-grid"><div><dt>分类器 / 方法</dt><dd>{view.classificationLineage.classifier} / {view.classificationLineage.method}</dd></div><div><dt>分类结果 SHA-256</dt><dd><code>{view.classificationLineage.assignmentsSha256}</code></dd></div><div><dt>语义分类批次</dt><dd>{view.classificationLineage.semanticBatchCount}</dd></div><div><dt>全主题复查阶段</dt><dd>{view.classificationLineage.fullThemeStageCount}</dd></div><div><dt>抽查样本 SHA-256</dt><dd><code>{view.classificationLineage.auditSampleSha256}</code></dd></div><div><dt>抽查结果 SHA-256</dt><dd><code>{view.classificationLineage.auditDecisionSha256}</code></dd></div><div><dt>抽样方法</dt><dd>{view.classificationLineage.auditSampleMethod}</dd></div><div><dt>低置信度论文 / 复查结果</dt><dd><code>{view.classificationLineage.lowQueueSha256}</code> / <code>{view.classificationLineage.lowDecisionSha256}</code> · {view.classificationLineage.lowComplete ? "已完成" : "未完成"}</dd></div></dl><h3>全主题复查过程</h3><ol class="lineage-stages">{view.classificationLineage.fullThemeStages.map((stage) => <li><article class="formula-entry"><strong>阶段 {stage.stageIndex}：{stage.sourceThemes.map(displayTopicLabel).join("、")}</strong><p>共复查 {stage.reviewedCount} 篇：保留原分类 {stage.keepCount} 篇，调整分类 {stage.correctionCount} 篇</p><dl class="audit-grid"><div><dt>复查方法</dt><dd>{stage.method}</dd></div><div><dt>复查前的分类结果 SHA-256</dt><dd><code>{stage.baseAssignmentsSha256}</code></dd></div><div><dt>复查后的分类结果 SHA-256</dt><dd><code>{stage.resultAssignmentsSha256}</code></dd></div></dl><h4>来源文件与对应版本</h4><ul>{stage.sources.map((source) => <li><strong>{displayTopicLabel(source.sourceTheme)}</strong> · {source.sourceFile} · <code>{source.sha256}</code> · 复查 {source.paperCount} 篇（保留 {source.keepCount}，调整 {source.correctionCount}）{source.assignmentBlobSha256 != null && <span> · 分类版本：<code>{source.assignmentBlobSha256}</code> · {source.sourceAssignmentFile} @ <code>{source.sourceCommit}</code></span>}</li>)}</ul><h4>主题调整明细</h4><ul>{stage.movements.map((movement) => <li>{displayTopicLabel(movement.sourceTheme)} → {displayTopicLabel(movement.targetTheme)}：{movement.count}</li>)}</ul></article></li>)}</ol><h3>AI 辅助复核记录</h3><ul>{view.classificationLineage.certificationSources.map((source) => <li>{source.source_file}：<code>{source.sha256}</code> · {source.decision_count} 条判断</li>)}</ul></section>}
        <section><h2>主题分类抽查</h2><div class="topic-table-wrap"><table><thead><tr><th>主题</th><th>抽查数量</th><th>分类正确数</th><th>抽查准确率</th><th>Wilson 95% 置信区间下界</th></tr></thead><tbody>{view.audits.map((audit) => <tr><th scope="row">{displayTopicLabel(audit.theme)}</th><td>{audit.sampleSize}</td><td>{audit.correctCount}</td><td>{audit.observedPrecision}</td><td>{audit.wilsonLower95}</td></tr>)}</tbody></table></div></section>
        <section><h2>暂不纳入主要分析的主题</h2><p>{view.withheldThemes.note}</p>{view.withheldThemes.items.map((item) => <article class="formula-entry"><strong>{displayTopicLabel(item.theme)} · {auditStatusLabel(item.status)}</strong><div><EvidenceBadge type={item.evidenceType} /><p>{item.claim}</p><small>{item.locator}</small><span class="claim-sources">{item.sourceUrls.map((url, index) => <a href={url}>来源 {index + 1}</a>)}</span></div></article>)}</section>
        <section><h2>已知局限</h2><ul>{view.knownLimitations.map((limitation) => <li>{limitation}</li>)}</ul></section>
      </div>
      </section>
      ))}
      </div>
      </div>
    )}
  </div>
</BaseLayout>
