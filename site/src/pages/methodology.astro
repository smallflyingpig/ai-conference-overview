---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceBadge from "../components/EvidenceBadge.astro";
import { loadOverview } from "../lib/data";
import { buildMethodologyView } from "../lib/evidence";
import { auditStatusLabel, displayTopicLabel } from "../lib/views";

const release = await loadOverview("ACL", 2026);
const view = release == null ? null : buildMethodologyView(release);
---

<BaseLayout title="方法论 — AI Conference Overview" description="数据来源、scope contract、公式、audit、缺失情况与已知局限。" conferenceAvailable={release != null}>
  <div class="evidence-shell methodology-shell">
    <header class="page-thesis methodology-thesis">
      <p class="eyebrow">Audit ledger</p>
      <h1>每一个数字，<br />都留下证据链。</h1>
      <p>发布 contract 以可操作证据呈现：source identity、抓取时间、scope、分母、公式、audit 与已知局限。</p>
    </header>
    {view == null ? (
      <div class="empty-atlas" role="status"><span class="status-mark" aria-hidden="true"></span><div><h3>尚未发布方法论 ledger</h3><p>只有 validated current release 存在时才展示。</p></div></div>
    ) : (
      <div class="audit-ledger">
        <section><h2>Build 标识</h2><dl class="audit-grid"><div><dt>生成时间</dt><dd><time datetime={view.build.generatedAt}>{view.build.generatedAt}</time></dd></div><div><dt>Producer</dt><dd><code>{view.build.producer}</code></dd></div><div><dt>Schema</dt><dd>{view.build.schemaVersion}</dd></div></dl></section>
        <section><h2>数据 provenance</h2>{view.sources.map((source) => <dl class="audit-grid"><div><dt>来源</dt><dd><a href={source.url}>{source.name}</a></dd></div><div><dt>SHA-256</dt><dd><code>{source.sha256}</code></dd></div><div><dt>抓取时间</dt><dd><time datetime={source.retrievedAt}>{source.retrievedAt}</time></dd></div></dl>)}</section>
        <section><h2>Scope contract</h2><dl class="audit-grid"><div><dt>会议 / 年份 / track</dt><dd>{view.scope.venue} / {view.scope.year} / {view.scope.track}</dd></div><div><dt>纳入状态</dt><dd>{view.scope.inclusionStatuses.join(", ")}</dd></div><div><dt>分母定义</dt><dd>{view.scope.denominator}</dd></div><div><dt>数值 / 单位</dt><dd>{view.scope.denominatorValue} {view.scope.denominatorUnit}</dd></div><div><dt>排除记录</dt><dd>{view.scope.exclusions}</dd></div><div><dt>Taxonomy</dt><dd>{view.taxonomyVersion}</dd></div><div><dt>比较 contract</dt><dd><code>{view.contractIds.comparison}</code></dd></div><div><dt>公式 contract</dt><dd>{view.contractIds.formula}</dd></div></dl></section>
        <section><h2>指标公式</h2>{view.formulas.map((formula) => <article class="formula-entry"><strong>{formula.name}</strong><code>{formula.formula}</code><small>{formula.version} · numerator：{formula.numerator}{formula.denominator ? ` · denominator：${formula.denominator}` : ""}</small></article>)}<dl class="audit-grid"><div><dt>配置会议</dt><dd>{view.configuredVenues.join(", ")}</dd></div><div><dt>Population ID</dt><dd><code>{view.contractIds.configuredVenuePopulation}</code></dd></div><div><dt>Emerging weights</dt><dd>share {view.emergingScoreWeights.share_growth}; spread {view.emergingScoreWeights.spread_growth}; novelty {view.emergingScoreWeights.novelty}</dd></div></dl></section>
        <section><h2>缺失情况</h2><dl class="audit-grid"><div><dt>Abstract</dt><dd>{view.missingness.abstracts}</dd></div><div><dt>PDF</dt><dd>{view.missingness.pdfs}</dd></div><div><dt>DOI</dt><dd>{view.missingness.dois}</dd></div></dl></section>
        <section><h2>低置信度复核</h2><dl class="audit-grid"><div><dt>Registry</dt><dd>{view.classificationReview.lowConfidenceCount} 条 assignment</dd></div><div><dt>已复核</dt><dd>{view.classificationReview.reviewedCount}</dd></div><div><dt>待复核</dt><dd>{view.classificationReview.pendingCount}</dd></div><div><dt>已拒绝</dt><dd>{view.classificationReview.rejectedCount}</dd></div><div><dt>是否完成</dt><dd>{view.classificationReview.complete ? "是" : "否：最终发布仍受门禁约束"}</dd></div></dl></section>
        {view.classificationLineage != null && <section><h2>分类 lineage</h2><dl class="audit-grid"><div><dt>Classifier / method</dt><dd>{view.classificationLineage.classifier} / {view.classificationLineage.method}</dd></div><div><dt>Assignments SHA-256</dt><dd><code>{view.classificationLineage.assignmentsSha256}</code></dd></div><div><dt>语义 batch</dt><dd>{view.classificationLineage.semanticBatchCount}</dd></div><div><dt>全主题复核阶段</dt><dd>{view.classificationLineage.fullThemeStageCount}</dd></div><div><dt>Audit sample SHA-256</dt><dd><code>{view.classificationLineage.auditSampleSha256}</code></dd></div><div><dt>Audit decision SHA-256</dt><dd><code>{view.classificationLineage.auditDecisionSha256}</code></dd></div><div><dt>采样边界</dt><dd>{view.classificationLineage.auditSampleMethod}</dd></div><div><dt>低置信度 queue / decision</dt><dd><code>{view.classificationLineage.lowQueueSha256}</code> / <code>{view.classificationLineage.lowDecisionSha256}</code> · {view.classificationLineage.lowComplete ? "已完成" : "未完成"}</dd></div></dl><h3>全主题复核链</h3><ol class="lineage-stages">{view.classificationLineage.fullThemeStages.map((stage) => <li><article class="formula-entry"><strong>阶段 {stage.stageIndex}：{stage.sourceThemes.map(displayTopicLabel).join("、")}</strong><p>复核 {stage.reviewedCount} 篇 · 保留 {stage.keepCount} 篇 · 修正 {stage.correctionCount} 篇</p><dl class="audit-grid"><div><dt>方法</dt><dd>{stage.method}</dd></div><div><dt>Base assignments SHA-256</dt><dd><code>{stage.baseAssignmentsSha256}</code></dd></div><div><dt>结果 / 下一阶段 binding</dt><dd><code>{stage.resultAssignmentsSha256}</code></dd></div></dl><h4>来源 artifact 与 binding</h4><ul>{stage.sources.map((source) => <li><strong>{displayTopicLabel(source.sourceTheme)}</strong> · {source.sourceFile} · <code>{source.sha256}</code> · 复核 {source.paperCount} 篇（保留 {source.keepCount}，修正 {source.correctionCount}）{source.assignmentBlobSha256 != null && <span> · Assignment blob binding：<code>{source.assignmentBlobSha256}</code> · {source.sourceAssignmentFile} @ <code>{source.sourceCommit}</code></span>}</li>)}</ul><h4>主题迁移矩阵</h4><ul>{stage.movements.map((movement) => <li>{displayTopicLabel(movement.sourceTheme)} → {displayTopicLabel(movement.targetTheme)}：{movement.count}</li>)}</ul></article></li>)}</ol><h3>认证来源</h3><ul>{view.classificationLineage.certificationSources.map((source) => <li>{source.source_file}：<code>{source.sha256}</code> · {source.decision_count} 条 decision</li>)}</ul></section>}
        <section><h2>主题 audit</h2><div class="topic-table-wrap"><table><thead><tr><th>主题</th><th>样本数</th><th>正确数</th><th>Observed precision</th><th>Wilson 95% 下界</th></tr></thead><tbody>{view.audits.map((audit) => <tr><th scope="row">{displayTopicLabel(audit.theme)}</th><td>{audit.sampleSize}</td><td>{audit.correctCount}</td><td>{audit.observedPrecision}</td><td>{audit.wilsonLower95}</td></tr>)}</tbody></table></div></section>
        <section><h2>暂缓 / 实验性主题</h2><p>{view.withheldThemes.note}</p>{view.withheldThemes.items.map((item) => <article class="formula-entry"><strong>{displayTopicLabel(item.theme)} · {auditStatusLabel(item.status)}</strong><div><EvidenceBadge type={item.evidenceType} /><p>{item.claim}</p><small>{item.locator}</small><span class="claim-sources">{item.sourceUrls.map((url, index) => <a href={url}>证据 {index + 1}</a>)}</span></div></article>)}</section>
        <section><h2>已知局限</h2><ul>{view.knownLimitations.map((limitation) => <li>{limitation}</li>)}</ul></section>
      </div>
    )}
  </div>
</BaseLayout>
