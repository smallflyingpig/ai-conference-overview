---
import "../styles/global.css";
import { conferenceNavigationHref, projectPath } from "../lib/paths";
import { focusRing } from "../lib/tokens";

interface Props {
  title: string;
  description: string;
  conferenceAvailable?: boolean;
}

const { title, description, conferenceAvailable = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const conferenceHref = conferenceNavigationHref(base, conferenceAvailable);
---

<!doctype html>
<html lang="zh-CN" style={`--focus-ring: ${focusRing}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到研究内容</a>
    <header class="site-header">
      <a class="wordmark" href={projectPath(base, "")} aria-label="AI Conference Overview 首页">
        <span aria-hidden="true">A/CO</span>
        <span>AI Conference Overview</span>
      </a>
      <nav aria-label="主导航">
        {conferenceHref ? <a href={conferenceHref}>会议概览</a> : <span aria-disabled="true">会议概览</span>}
        <a href={projectPath(base, "trends")}>分布与趋势</a>
        <a href={projectPath(base, "advances")}>研究进展</a>
        <a href={projectPath(base, "awards")}>获奖论文</a>
        <a href={projectPath(base, "papers")}>论文索引</a>
        <a href={projectPath(base, "methodology")}>方法论</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <span>先呈现证据，再给出解释。</span>
      <span class="data-label">MIT · 静态研究图谱</span>
    </footer>
  </body>
</html>
