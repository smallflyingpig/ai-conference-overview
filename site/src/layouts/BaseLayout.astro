---
import "../styles/global.css";
import { conferenceNavigationHref, projectPath } from "../lib/paths";
import { focusRing } from "../lib/tokens";

interface Props {
  title: string;
  description: string;
  conferenceAvailable?: boolean;
}

const { title, description, conferenceAvailable = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const conferenceHref = conferenceNavigationHref(base, conferenceAvailable);
---

<!doctype html>
<html lang="zh-CN" style={`--focus-ring: ${focusRing}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="wordmark" href={projectPath(base, "")} aria-label="AI Conference Overview 首页">
        <span aria-hidden="true">A/CO</span>
        <span>AI Conference Overview</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="打开主导航">
        <span aria-hidden="true">菜单</span>
      </button>
      <nav class="site-nav" id="site-navigation" aria-label="主导航">
        {conferenceHref ? <a href={conferenceHref}>会议概览</a> : <span aria-disabled="true">会议概览</span>}
        <a href={projectPath(base, "trends")}>分布与趋势</a>
        <a href={projectPath(base, "advances")}>研究进展</a>
        <a href={projectPath(base, "awards")}>获奖论文</a>
        <a href={projectPath(base, "papers")}>论文索引</a>
        <a href={projectPath(base, "methodology")}>方法说明</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <span>所有分析都附有资料来源，并注明适用范围。</span>
      <span class="data-label">MIT · 静态研究网站</span>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const navigation = document.querySelector<HTMLElement>("#site-navigation");

      function setNavigationOpen(open: boolean) {
        toggle?.setAttribute("aria-expanded", String(open));
        toggle?.setAttribute("aria-label", open ? "关闭主导航" : "打开主导航");
        navigation?.classList.toggle("is-open", open);
      }

      toggle?.addEventListener("click", () => {
        setNavigationOpen(toggle.getAttribute("aria-expanded") !== "true");
      });
      navigation?.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) setNavigationOpen(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setNavigationOpen(false);
      });
    </script>
  </body>
</html>
