---
interface Props {
  included: number;
  excluded: number;
  discovered: number;
  abstractCoverage: string;
  retrievedAt: string;
  sourceName: string;
  sourceUrl: string;
  sourceHash: string;
}

const { included, excluded, discovered, abstractCoverage, retrievedAt, sourceName, sourceUrl, sourceHash } = Astro.props;
---

<section class="data-status" aria-labelledby="data-status-title">
  <p class="eyebrow">数据完整性</p>
  <h2 id="data-status-title">论文清单已经完成检查</h2>
  <dl>
    <div><dt>纳入</dt><dd>{included}</dd></div>
    <div><dt>排除</dt><dd>{excluded}</dd></div>
    <div><dt>发现</dt><dd>{discovered}</dd></div>
    <div><dt>摘要覆盖</dt><dd>{abstractCoverage}</dd></div>
  </dl>
  <p class="source-note">
    <span>抓取时间 <time datetime={retrievedAt}>{retrievedAt.slice(0, 10)}</time></span>
    <a href={sourceUrl}>{sourceName}</a>
    <code title={sourceHash}>sha256:{sourceHash.slice(0, 12)}</code>
  </p>
</section>
