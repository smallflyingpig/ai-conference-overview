---
interface Props {
  venue: string;
  year: number;
  scope: string;
  paperCount: number;
  href: string;
  retrievedAt: string;
  linkLabel?: string;
}
const { venue, year, scope, paperCount, href, retrievedAt, linkLabel = `查看 ${venue} ${year}` } = Astro.props;
---

<article class="conference-entry">
  <div>
    <p class="eyebrow">已整理的会议数据</p>
    <h3>{venue} {year}</h3>
  </div>
  <dl>
    <div><dt>范围</dt><dd>{scope}</dd></div>
    <div><dt>论文数</dt><dd>{paperCount} 篇</dd></div>
    <div><dt>数据日期</dt><dd>{retrievedAt.slice(0, 10)}</dd></div>
  </dl>
  <a href={href}>{linkLabel} <span aria-hidden="true">→</span></a>
</article>
