---
interface Props {
  venue: string;
  year: number;
  scope: string;
  paperCount: number;
  href: string;
  retrievedAt: string;
}
const { venue, year, scope, paperCount, href, retrievedAt } = Astro.props;
---

<article class="conference-entry">
  <div>
    <p class="eyebrow">已验证会议 snapshot</p>
    <h3>{venue} {year}</h3>
  </div>
  <dl>
    <div><dt>范围</dt><dd>{scope}</dd></div>
    <div><dt>分母</dt><dd>{paperCount} 篇纳入论文</dd></div>
    <div><dt>数据日期</dt><dd>{retrievedAt.slice(0, 10)}</dd></div>
  </dl>
  <a href={href}>查看分布 <span aria-hidden="true">→</span></a>
</article>
